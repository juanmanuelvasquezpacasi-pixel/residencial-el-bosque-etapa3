      { id: "43", num: "43", sector: "Isla Central", area: "100.00 m²", estado: "disponible", px: 40.5, py: 66.5, ax: 33.6, ay: 46.2 },
      { id: "44", num: "44", sector: "Isla Central", area: "100.00 m²", estado: "disponible", px: 33.5, py: 65.2, ax: 34.2, ay: 39.5 },
      { id: "45", num: "45", sector: "Isla Central", area: "90.00 m²",  estado: "disponible", px: 39.2, py: 71.0, ax: 28.2, ay: 45.2 },
      { id: "46", num: "46", sector: "Isla Central", area: "90.00 m²",  estado: "disponible", px: 32.2, py: 69.8, ax: 29.3, ay: 38.8 }
    ];

    // ==========================================
    // 3. VISOR SIN PIXELADO (Encaje nativo 1:1)
    // ==========================================
    const viewport = document.getElementById("viewport");
    const container = document.getElementById("canvas-container");
    const mapaImg = document.getElementById("mapa-img");
    const aerialPin = document.getElementById("aerialPin");
    const aerialPinText = document.getElementById("aerialPinText");

    let scale = 1, minScale = 0.5, maxScale = 2.0;
    let posX = 0, posY = 0;
    let isDragging = false, startX = 0, startY = 0;
    let modoCalibrar = false;
    let loteActivoId = "01";

    function updateTransform(smooth = false) {
      container.style.transition = smooth
        ? "transform 0.45s cubic-bezier(0.22, 1, 0.36, 1)"
        : "none";
      container.style.transform = `translate(${posX}px, ${posY}px) scale(${scale})`;
    }

    function fitImage() {
      if (!mapaImg.naturalWidth) return;
      const vw = viewport.clientWidth;
      const vh = viewport.clientHeight;
      // Encaja toda la imagen sin recortar ni estirar píxeles
      minScale = Math.min(vw / mapaImg.naturalWidth, vh / mapaImg.naturalHeight);
      scale = minScale;
      posX = (vw - mapaImg.naturalWidth * scale) / 2;
      posY = (vh - mapaImg.naturalHeight * scale) / 2;
      updateTransform(true);
    }

    mapaImg.onload = () => {
      fitImage();
      seleccionarLote("01", false);
    };
    window.addEventListener("resize", fitImage);

    viewport.addEventListener("wheel", (e) => {
      e.preventDefault();
      const rect = viewport.getBoundingClientRect();
      const mx = e.clientX - rect.left;
      const my = e.clientY - rect.top;
      const delta = e.deltaY < 0 ? 1.15 : 0.85;
      const newScale = Math.min(maxScale, Math.max(minScale, scale * delta));
      posX = mx - (mx - posX) * (newScale / scale);
      posY = my - (my - posY) * (newScale / scale);
      scale = newScale;
      updateTransform(false);
    }, { passive: false });

    viewport.addEventListener("pointerdown", (e) => {
      if (modoCalibrar) {
        const rect = container.getBoundingClientRect();
        const ax = Number((((e.clientX - rect.left) / rect.width) * 100).toFixed(1));
        const ay = Number((((e.clientY - rect.top) / rect.height) * 100).toFixed(1));
        const lote = LOTES.find(l => l.id === loteActivoId);
        if (lote) {
          lote.ax = ax;
          lote.ay = ay;
          aerialPin.style.left = `${ax}%`;
          aerialPin.style.top = `${ay}%`;
          const toast = document.getElementById("coord-toast");
          toast.textContent = `Lote ${lote.num} actualizado → ax: ${ax}, ay: ${ay}`;
          toast.style.display = "block";
          setTimeout(() => toast.style.display = "none", 3500);
        }
        return;
      }
      isDragging = true;
      startX = e.clientX - posX;
      startY = e.clientY - posY;
    });

    window.addEventListener("pointermove", (e) => {
      if (!isDragging) return;
      posX = e.clientX - startX;
      posY = e.clientY - startY;
      updateTransform(false);
    });
    window.addEventListener("pointerup", () => { isDragging = false; });

    document.getElementById("calibBtn").onclick = function () {
      modoCalibrar = !modoCalibrar;
      this.classList.toggle("active", modoCalibrar);
      viewport.style.cursor = modoCalibrar ? "crosshair" : "grab";
    };

    document.getElementById("zoomIn").onclick = () => {
      const vw = viewport.clientWidth / 2, vh = viewport.clientHeight / 2;
      const newScale = Math.min(maxScale, scale * 1.25);
      posX = vw - (vw - posX) * (newScale / scale);
      posY = vh - (vh - posY) * (newScale / scale);
      scale = newScale;
      updateTransform(true);
    };
    document.getElementById("zoomOut").onclick = () => {
      const vw = viewport.clientWidth / 2, vh = viewport.clientHeight / 2;
      const newScale = Math.max(minScale, scale * 0.78);
      posX = vw - (vw - posX) * (newScale / scale);
      posY = vh - (vh - posY) * (newScale / scale);
      scale = newScale;
      updateTransform(true);
    };
    document.getElementById("zoomReset").onclick = fitImage;

    // ==========================================
    // 4. SELECCIÓN DE LOTES
    // ==========================================
    const planoBox = document.getElementById("planoBox");
    const sectorFilter = document.getElementById("sectorFilter");
    const loteSelect = document.getElementById("loteSelect");

    function renderHotspots() {
      planoBox.querySelectorAll(".hotspot-dot").forEach(el => el.remove());
      const filtro = sectorFilter.value;

      LOTES.forEach(lote => {
        if (filtro !== "todos" && lote.sector !== filtro) return;
        const dot = document.createElement("div");
        dot.className = `hotspot-dot ${lote.estado}`;
        dot.dataset.id = lote.id;
        dot.style.left = `${lote.px}%`;
        dot.style.top = `${lote.py}%`;
        dot.textContent = lote.num;
        dot.title = `Lote ${lote.num} — ${lote.area}`;
        dot.onclick = () => seleccionarLote(lote.id, true);
        planoBox.appendChild(dot);
      });
    }

    function populateSelect() {
      const filtro = sectorFilter.value;
      loteSelect.innerHTML = "";
      const lista = LOTES.filter(l => filtro === "todos" || l.sector === filtro);
      lista.forEach(l => {
        const opt = document.createElement("option");
        opt.value = l.id;
        opt.textContent = `Lote ${l.num} (${l.area})`;
        loteSelect.appendChild(opt);
      });
      if (lista.length > 0) seleccionarLote(lista[0].id, false);
    }

    function seleccionarLote(id, animarZoom = true) {
      const lote = LOTES.find(l => l.id === id);
      if (!lote) return;
      loteActivoId = id;
      loteSelect.value = id;

      planoBox.querySelectorAll(".hotspot-dot").forEach(d => {
        d.classList.toggle("active", d.dataset.id === id);
      });

      document.getElementById("fichaTitle").textContent = `Lote ${lote.num}`;
      document.getElementById("fichaSector").textContent = lote.sector;
      document.getElementById("fichaArea").textContent = lote.area;

      const badge = document.getElementById("fichaEstado");
      badge.className = `badge ${lote.estado}`;
      badge.textContent = lote.estado;
      document.getElementById("fichaEstadoText").textContent =
        lote.estado.charAt(0).toUpperCase() + lote.estado.slice(1);

      const waBtn = document.getElementById("waReserveBtn");
      if (lote.estado === "disponible") {
        waBtn.classList.remove("disabled");
        waBtn.textContent = `💬 Reservar Lote ${lote.num} (${lote.area})`;
        const texto = encodeURIComponent(
          `Hola ${asesor.nombre}, quiero reservar el Lote ${lote.num} (${lote.sector}) con un área total de ${lote.area} en Residencial El Bosque - 3ra Etapa.`
        );
        waBtn.href = `https://wa.me/${asesor.whatsapp}?text=${texto}`;
      } else {
        waBtn.classList.add("disabled");
        waBtn.textContent = `Lote ${lote.estado}`;
        waBtn.href = "#";
      }

      if (mapaImg.naturalWidth) {
        aerialPin.style.left = `${lote.ax}%`;
        aerialPin.style.top = `${lote.ay}%`;
        aerialPin.style.display = "flex";
        aerialPinText.textContent = `Lote ${lote.num} • ${lote.area}`;

        if (animarZoom) {
          // Zoom suave (máximo 1.15x del tamaño real para mantener nitidez)
          const targetX = (lote.ax / 100) * mapaImg.naturalWidth;
          const targetY = (lote.ay / 100) * mapaImg.naturalHeight;
          scale = Math.min(1.15, Math.max(minScale * 1.35, scale));
          posX = viewport.clientWidth / 2 - targetX * scale;
          posY = viewport.clientHeight / 2 - targetY * scale;
          updateTransform(true);
        }
      }
    }

    sectorFilter.onchange = () => {
      renderHotspots();
      populateSelect();
    };
    loteSelect.onchange = (e) => seleccionarLote(e.target.value, true);

    const sidebar = document.getElementById("sidebar");
    document.getElementById("toggleBtn").onclick = () => {
      sidebar.classList.toggle("closed");
    };

    renderHotspots();
    populateSelect();
  </script>
</body>
</html>