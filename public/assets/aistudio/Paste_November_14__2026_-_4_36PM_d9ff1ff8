      position: fixed;
      bottom: 20px;
      left: 72px;
      background: var(--verde-pino);
      color: var(--amarillo);
      padding: 8px 14px;
      border-radius: 8px;
      font-size: 12px;
      font-family: monospace;
      font-weight: 700;
      display: none;
      z-index: 50;
      border: 2px solid var(--amarillo);
    }

