      .mobile-toggle { display: block; }
      aside#sidebar {
        position: absolute;
        right: 0; top: 0; bottom: 0;
        width: 100%;
        max-width: 400px;
        transition: transform 0.3s ease;
      }
      aside#sidebar.closed { transform: translateX(100%); }
    }
  </style>
